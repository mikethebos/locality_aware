#!/bin/sh
#Submit using flux batch <filename>

#flux: --job-name=alltoall_plus_copyto16ppg_and_cpuwinto16ppg_n64
#flux: --output='alltoall_plus_copyto16ppg_and_cpuwinto16ppg_n64.{{id}}.out'
#flux: --error='alltoall_plus_copyto16ppg_and_cpuwinto16ppg_n64.{{id}}.err'
#flux: -N 64
#flux: -l # Add task rank prefixes to each line of output.
#flux: --setattr=thp=always # Enable Transparent Huge Pages (THP)
#flux: -t 60
#flux: -q pbatch

module load rocmcc/7.2.1-magic
module load cray-mpich/9.1.0

export MPICH_GPU_SUPPORT_ENABLED=1
export HSA_XNACK=1

# Check if THP are enabled
#cat /sys/kernel/mm/transparent_hugepage/enabled

cd $HOME/MPICCL/build/benchmarks

n_nodes=64
gpus_per_node=4
max_cores=21

for ppg in 1 2 4 8 16; do
  n_procs=$(( ppg * gpus_per_node * n_nodes ))
  n_cores=$(( max_cores / ppg ))
  echo "${ppg} Processes Per GPU, ${gpus_per_node} GPUs Per Node"
  
  if [ "$ppg" -eq 1 ]; then
    flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
        --setopt=mpibind=verbose:2 ./alltoall
  else
    flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
        --setopt=mpibind=verbose:2 ./alltoall_copy
  fi
done

for ppg in 2 4 8 16; do
  n_procs=$(( ppg * gpus_per_node * n_nodes ))
  n_cores=$(( max_cores / ppg ))
  echo "${ppg} Processes Per GPU, ${gpus_per_node} GPUs Per Node"
  
  flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
      --setopt=mpibind=verbose:2 ./cpu_alltoall_extraproc
done

