#!/bin/bash
#SBATCH --nodes=2
#SBATCH --partition=ghx4
#SBATCH --time=00:45:00
#SBATCH --job-name cpu_microbenchmarks
#SBATCH --output cpu_microbenchmarks.%j.out
#SBATCH --error cpu_microbenchmarks.%j.err
#SBATCH --account=bebi-dtai-gh
#SBATCH --gres=gpu:nvidia_gh200_120gb:4
#SBATCH --exclusive
#SBATCH --mem=0

module load PrgEnv-gnu/8.6.0
module load gcc-native/14
module load libfabric/2.3.1
module load cudatoolkit/25.5_12.9
export CUDA_PATH=/opt/nvidia/hpc_sdk/Linux_aarch64/25.5/cuda/12.9
module load cray-mpich/9.0.1

export MPICH_GPU_SUPPORT_ENABLED=1

cd $HOME/locality_aware-mikethebos/build-with-cuda/benchmarks

srun -n 512 --ntasks-per-socket=64 --gres=gpu:nvidia_gh200_120gb:4 --cpu-bind=cores,verbose --gpu-bind=single:64,verbose --gres-flags=allow-task-sharing --distribution=block:block ./microbenchmarks
