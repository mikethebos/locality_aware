export OMP_NUM_THREADS=1
jsrun -a1 -c1 -g1 -r4 -n32 -bpacked:1 -dpacked -EOMP_NUM_THREADS=1 --print_placement=1 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed ./test_suitesparse_neighbor_alltoallv_init_matblockvec_gpu

