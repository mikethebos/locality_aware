# LSBATCH: User input
#!/bin/bash
#BSUB -J gpu_alltoall_compare64
#BSUB -e gpu_alltoall_compare64.%J.err
#BSUB -o gpu_alltoall_compare64.%J.out
#BSUB -nnodes 64
#BSUB -q pbatch
#BSUB -W 02:00
 
module load gcc/8.3.1
module load cuda/11.2.0
module load hwloc

cd $HOME/locality_aware-mikethebos/build/benchmarks

export OMP_NUM_THREADS=1
echo "Running Unthreaded Alltoall Test:"
jsrun -n256 -r4 -a1 -c1 -g1 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed --print_placement=1 ./gpu_alltoall_quick

export MV2_USE_ALIGNED_ALLOC=1

export OMP_NUM_THREADS=2
echo "Running Threaded Alltoall Test with launches, 2 threads"
jsrun -n256 -r4 -a1 -c2 -g1 -bpacked:2 -dpacked -EOMP_NUM_THREADS=2 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed --print_placement=1 ./thread_launches 2

export OMP_NUM_THREADS=2
echo "Running Threaded Alltoall Test without launches, 2 threads"
jsrun -n256 -r4 -a1 -c2 -g1 -bpacked:2 -dpacked -EOMP_NUM_THREADS=2 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed --print_placement=1 ./no_thread_launches 2

export OMP_NUM_THREADS=4
echo "Running Threaded Alltoall Test with launches, 4 threads"
jsrun -n256 -r4 -a1 -c4 -g1 -bpacked:4 -dpacked -EOMP_NUM_THREADS=4 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed --print_placement=1 ./thread_launches 4

export OMP_NUM_THREADS=4
echo "Running Threaded Alltoall Test without launches, 4 threads"
jsrun -n256 -r4 -a1 -c4 -g1 -bpacked:4 -dpacked -EOMP_NUM_THREADS=4 -M "-gpu" --latency_priority=gpu-cpu --launch_distribution=packed --print_placement=1 ./no_thread_launches 4

export OMP_NUM_THREADS=8
