#!/bin/sh
#Submit using flux batch <filename>

#flux: --job-name=cpu_hyprecg_compare_hypre3.1.0_n32
#flux: --output='cpu_hyprecg_compare_hypre3.1.0_n32.{{id}}.out'
#flux: --error='cpu_hyprecg_compare_hypre3.1.0_n32.{{id}}.err'
#flux: -N 32
#flux: -l # Add task rank prefixes to each line of output.
#flux: --setattr=thp=always # Enable Transparent Huge Pages (THP)
#flux: -t 20
#flux: -q pbatch

module load rocmcc/7.2.1-magic
module load cray-mpich/9.1.0

export MPICH_GPU_SUPPORT_ENABLED=1
export HSA_XNACK=1

# Check if THP are enabled
#cat /sys/kernel/mm/transparent_hugepage/enabled

n_nodes=32
gpus_per_node=4
max_cores=21

Px=16
Py=16
Pz=8

run_tests() {
  for ppg in 16; do
    n_procs=$(( ppg * gpus_per_node * n_nodes ))
    n_cores=$(( max_cores / ppg ))
    echo "${ppg} Processes Per GPU, ${gpus_per_node} GPUs Per Node"
    
    for N in 64 128 256; do
      N_first=$(( (N / 2) * 3 ))
      echo "Global matrix size: ${N_first} x ${N_first} x ${N_first}"
      
      echo "5pt 2D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -solver 2 -laplacian -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}

      echo "27pt 3D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -solver 2 -27pt -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}

      echo "125pt 3D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -solver 2 -125pt -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}
    done
  done
}

echo "Running baseline test"
cd $HOME/hypre-3.1.0/src/build-with-tests/test
run_tests

echo "Running high radix test"
cd $HOME/hypre-mikethebos-3.1.0/src/build-with-tests/test
run_tests
