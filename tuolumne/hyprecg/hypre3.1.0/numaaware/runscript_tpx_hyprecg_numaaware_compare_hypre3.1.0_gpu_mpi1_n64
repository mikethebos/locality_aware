#!/bin/sh
#Submit using flux batch <filename>

#flux: --job-name=tpx_hyprecg_numaaware_compare_hypre3.1.0_gpu_mpi1_n64
#flux: --output='tpx_hyprecg_numaaware_compare_hypre3.1.0_gpu_mpi1_n64.{{id}}.out'
#flux: --error='tpx_hyprecg_numaaware_compare_hypre3.1.0_gpu_mpi1_n64.{{id}}.err'
