#flux: -l # Add task rank prefixes to each line of output.
#flux: --setattr=thp=always # Enable Transparent Huge Pages (THP)
#flux: -t 20
#flux: -q pbatch
#flux: --setattr=gpumode=CPX
#flux: --conf=resource.rediscover=true

module load rocmcc/6.4.0-magic
module load cce/19.0.0
module load cray-mpich/9.0.1

export MPICH_GPU_SUPPORT_ENABLED=1
export HSA_XNACK=1

# Check if THP are enabled
#cat /sys/kernel/mm/transparent_hugepage/enabled

n_nodes=4
gpus_per_node=24
max_cores=3

Px=6
Py=4
Pz=4

run_tests() {
  for ppg in 1; do
    n_procs=$(( ppg * gpus_per_node * n_nodes ))
    n_cores=$(( max_cores / ppg ))
    echo "${ppg} Processes Per GPU, ${gpus_per_node} GPUs Per Node"
    
    for N in 64 128 256; do
      N_first=$(( (N / 2) * 3 ))
      echo "Global matrix size: ${N_first} x ${N_first} x ${N_first}"
      
      echo "5pt 2D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -gpu_mpi 1 -solver 2 -laplacian -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}

      echo "27pt 3D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -gpu_mpi 1 -solver 2 -27pt -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}

      echo "125pt 3D Laplacian"
      flux run -N${n_nodes} -n${n_procs} -c${n_cores} --verbose --exclusive\
	  --setopt=mpibind=verbose:2 ./ij -gpu_mpi 1 -solver 2 -125pt -n ${N_first} ${N_first} ${N_first} -P ${Px} ${Py} ${Pz}
    done
  done
}

echo "Running baseline test"
cd $HOME/hypre-2.33.0/src/build-with-gpu-and-tests/test
run_tests

echo "Running numa aware test"
cd $HOME/hypre-mikethebos-numaaware/src/build-with-gpu-and-tests/test
run_tests
