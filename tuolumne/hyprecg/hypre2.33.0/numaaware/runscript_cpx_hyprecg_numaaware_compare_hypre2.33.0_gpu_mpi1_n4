#!/bin/sh
#Submit using flux batch <filename>

#flux: --job-name=cpx_hyprecg_numaaware_compare_hypre2.33.0_gpu_mpi1_n4
#flux: --output='cpx_hyprecg_numaaware_compare_hypre2.33.0_gpu_mpi1_n4.{{id}}.out'
#flux: --error='cpx_hyprecg_numaaware_compare_hypre2.33.0_gpu_mpi1_n4.{{id}}.err'
